# Per-target deployment settings. Copy this to a real file (e.g. prod.env) and
# fill in your values, then pass the file to any script:
#
#   ./k8s/build-and-deploy.sh k8s/env/prod.env
#
# Keep one file per domain/host (prod.env, staging.env, …) and switch targets
# just by changing the file you pass. A positional <ssh-host>/<mode> after the
# file still overrides SSH_HOST/MODE.
#
# Real *.env files in this folder are git-ignored (see .gitignore); only the
# *.example templates are tracked.

# Where to deploy (SSH target for the MicroK8s node)
SSH_HOST=ubuntu@my-vps

# local = plain HTTP catch-all; letsencrypt = real TLS cert for DOMAIN
MODE=letsencrypt

# Public domain - must already resolve to the cluster. Used for the ingress
# host and the TLS certificate. Required for letsencrypt mode.
DOMAIN=short.example.com

# Email for Let's Encrypt / ACME registration. Required for letsencrypt mode.
ACME_EMAIL=me@example.com

# Public base for the short links shown in the UI. Optional - defaults to
# https://$DOMAIN/ (letsencrypt) or http://localhost/ (local).
# SHORTCODE_BASE_URL=https://short.example.com/
